# Dependencies
node_modules/

# Build output (Chrome/Edge bundle, Firefox bundle, release archives)
dist/
dist-firefox/
release/
*.zip
*.xpi

# Generated assets (recreated by `npm run build` / `npm run icons`)
public/icons/*.png

# Caches
.vite/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.sass-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (never commit secrets such as AI API keys)
.env
.env.*
!.env.example

# Editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# Operating systems
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local scratch
*.local
tmp/
temp/
coverage/
