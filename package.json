{
  "name": "jobpaal-extension",
  "productName": "JobPaal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JobPaal - AI job-application copilot. Tailors your resume, CV and cover letter to any job posting.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "dev": "node scripts/build.mjs chrome --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-core.mjs && node scripts/smoke-render.mjs && node scripts/smoke-background.mjs",
    "package": "node scripts/package.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-firefox',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.6.0": true
  }
}
